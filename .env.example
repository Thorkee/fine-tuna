# -----------------------------
# Tuna app environment template
# -----------------------------

# Client-exposed (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase/admin
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST_OVERRIDE=

# DB connection helpers (migrations/checks)
# Set ONE of these:
POSTGRES_URL=
DATABASE_URL=
SUPABASE_DB_URL=

# --------------------------------
# LLM provider configuration
# --------------------------------
# aws_bedrock | azure_openai | openai
TUNA_LLM_PROVIDER=aws_bedrock

# Azure OpenAI (required when provider=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_AUTH_TOKEN=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure/OpenAI note:
# Azure calls are deployment-scoped and api-versioned, for example:
# POST https://{endpoint}/openai/deployments/{deployment-id}/completions?api-version={api-version}

# OpenAI (required when provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# AWS Bedrock (required when provider=aws_bedrock)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=
# Static IAM credentials for Bedrock (required for Vercel / serverless deploys;
# locally you can use `aws login` instead).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------
# Storage (server-side file ops)
# -----------------------------
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_KEY_ID=
SUPABASE_STORAGE_SECRET=

# -----------------------------
# Runner (optional)
# -----------------------------
E2B_RUNNER_URL=
E2B_RUNNER_TOKEN=
E2B_RUNNER_TIMEOUT_MS=30000
E2B_API_KEY=
RUNNER_MAX_FILE_BYTES=
RUNNER_SIGNED_URL_TTL_SECONDS=
RUNNER_MODEL_COPY_MAX_BYTES=

# -----------------------------
# Source policy (optional)
# -----------------------------
# off | prefer | strict
TUNA_AGENT_SOURCE_POLICY_STRICTNESS=prefer
TUNA_AGENT_SOURCE_POLICY_FALLBACK_GOV=true
TUNA_AGENT_SOURCE_POLICY_FALLBACK_OPEN_WEB=true
TUNA_AGENT_SOURCE_POLICY_MIN_RESULTS_PER_TIER=3
TUNA_AGENT_MODEL_BENCHMARK_MAX_AGE_DAYS=60
TUNA_AGENT_PREFERRED_BASE_MODELS=

# Agent context window tuning (optional)
TUNA_AGENT_MAX_CONTEXT_TOKENS=
TUNA_AGENT_MAX_INPUT_TOKENS=
TUNA_AGENT_MAX_OUTPUT_TOKENS=
TUNA_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=2048
TUNA_AGENT_SUMMARY_MAX_OUTPUT_TOKENS=9000
TUNA_AGENT_SUMMARY_TRIGGER_FRACTION=0.8
TUNA_AGENT_LOG_CONTEXT=false
TUNA_AGENT_MAX_RUN_MS=600000
TUNA_AGENT_TOOL_MESSAGE_MAX_CHARS=
TUNA_AGENT_ASSISTANT_MESSAGE_MAX_CHARS=
TUNA_AGENT_SUMMARY_MAX_CHARS=

# -----------------------------
# Integrations (optional)
# -----------------------------
HUGGINGFACE_TOKEN=
HF_TOKEN=
GITHUB_TOKEN=
KAGGLE_TOKEN=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# MCP connectors (optional JSON string)
TUNA_MCP_SERVERS=

# -----------------------------
# Email notifications (optional)
# -----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=TUNA
TUNA_QUEUED_TASK_START_EMAIL_COOLDOWN_MINUTES=60

# -----------------------------
# Billing (optional)
# -----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_SUBSCRIPTION_PRICE_ID=
NEXT_PUBLIC_STRIPE_TOPUP_PRICE_ID=

# -----------------------------
# SageMaker + W&B (optional)
# -----------------------------
SAGEMAKER_EXECUTION_ROLE_ARN=
SAGEMAKER_TRAINING_IMAGE_URI=
SAGEMAKER_OUTPUT_S3_URI=
SAGEMAKER_INSTANCE_TYPE=
SAGEMAKER_MAX_RUNTIME_SECONDS=
SAGEMAKER_POLL_INTERVAL_SECONDS=
WANDB_API_KEY=
WANDB_PROJECT=tuna
WANDB_ENTITY=