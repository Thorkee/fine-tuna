# Supabase Configuration
# Optional: for migrate.js and check-migration.js use DATABASE_URL or SUPABASE_DB_HOST + SUPABASE_DB_PASSWORD, etc.
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL=your-postgres-url

# DB connection (used by migrate.js and check-migration.js)
# Prefer setting ONE of: POSTGRES_URL, DATABASE_URL, or SUPABASE_DB_URL.
DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
# Optional helpers for Supabase pooler + IPv4 workarounds.
SUPABASE_PROJECT_REF=
SUPABASE_DB_USER_OVERRIDE=
SUPABASE_DB_HOST_OVERRIDE=
SUPABASE_DB_PORT_OVERRIDE=
# Common Postgres env aliases (optional).
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

SUPABASE_STORAGE_URL=your-supabase-storage-url
SUPABASE_STORAGE_REGION=us-east-2
SUPABASE_STORAGE_KEY_ID=your-supabase-storage-key-id
SUPABASE_STORAGE_SECRET=your-supabase-storage-secret

# Files Drawer / storage limits (server-side)
FILES_DRAWER_MAX_EDIT_BYTES=500000
FILES_DRAWER_MAX_COPY_BYTES=20000000
FILES_DRAWER_MAX_PERSIST_BYTES=20000000
FILES_DRAWER_MAX_PERSIST_FILES=1000
FILES_DRAWER_MAX_PERSIST_TREE_BYTES=100000000
FILES_DRAWER_SIGNED_URL_TTL_SECONDS=600

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_AUTH_TOKEN=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.2
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional: debug logging (server-side)
AZURE_OPENAI_LOG_PROMPT_CACHE=false
# LLM provider selector (server-only): aws_bedrock | azure_openai | openai
TUNA_LLM_PROVIDER=aws_bedrock
# Rebrand guard: do not introduce legacy alias env names in new changes.

# AWS Bedrock (server-only, when TUNA_LLM_PROVIDER=aws_bedrock)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=

# SageMaker + Weights & Biases (server-only; training path)
SAGEMAKER_EXECUTION_ROLE_ARN=
SAGEMAKER_TRAINING_IMAGE_URI=
SAGEMAKER_OUTPUT_S3_URI=
WANDB_API_KEY=
WANDB_PROJECT=tuna
WANDB_ENTITY=

# Compute Providers
LAMBDA_LABS_API_KEY=your-lambda-labs-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

EXA_API_KEY=your-exa-ai-web-search-api-key

# MCP Connectors (optional)
# JSON array of MCP server configs. Supports:
# - transport: http (Streamable HTTP MCP server)
# - transport: stdio (local process; usually dev only)
# Example:
# TUNA_MCP_SERVERS=[{"id":"linear","label":"Linear","transport":"http","url":"https://your-mcp-server.example.com/mcp","headers":{"Authorization":"Bearer YOUR_TOKEN"}}]
# Firecrawl (stdio) example:
# TUNA_MCP_SERVERS={"mcpServers":{"firecrawl-mcp":{"command":"npx","args":["-y","firecrawl-mcp"],"env":{"FIRECRAWL_API_KEY":"$FIRECRAWL_API_KEY"}}}}
TUNA_MCP_SERVERS=

# Source policy for dataset/model discovery (server-side)
# Modes: off | prefer | strict
TUNA_AGENT_SOURCE_POLICY_STRICTNESS=prefer
# Whether the agent may fall back from Hugging Face to secondary trusted sources (GitHub/Kaggle + optional public portals).
TUNA_AGENT_SOURCE_POLICY_FALLBACK_GOV=true
# Whether the agent may use broad open-web fallback when preferred and gov sources are insufficient.
TUNA_AGENT_SOURCE_POLICY_FALLBACK_OPEN_WEB=true
# Minimum acceptable result count before escalating to the next source tier.
TUNA_AGENT_SOURCE_POLICY_MIN_RESULTS_PER_TIER=3
# Freshness window for benchmark weighting (used in OSS model ranking).
TUNA_AGENT_MODEL_BENCHMARK_MAX_AGE_DAYS=60
# Optional comma-separated overrides.
# TUNA_AGENT_PREFERRED_BASE_MODELS=meta-llama/Llama-3.1-8B-Instruct,Qwen/Qwen2.5-7B-Instruct
# TUNA_AGENT_DATASET_TIER1_DOMAINS=huggingface.co,datasets-server.huggingface.co
# TUNA_AGENT_DATASET_TIER2_DOMAINS=github.com,kaggle.com,data.gov
# TUNA_AGENT_MODEL_TIER1_DOMAINS=huggingface.co
# TUNA_AGENT_MODEL_TIER2_DOMAINS=github.com,kaggle.com,paperswithcode.com,arxiv.org
# TUNA_AGENT_BENCHMARK_DOMAINS=lmarena.ai,huggingface.co,paperswithcode.com,artificialanalysis.ai

# Agent Budgets (server-side)
# Increase these if you see: "I stopped because I hit the time budget (...ms)"
TUNA_AGENT_MAX_RUN_MS=600000
TUNA_AGENT_MAX_ITERATIONS=60
TUNA_AGENT_MAX_TOOL_CALLS_TOTAL=250

# Optional generic fallback env vars
# AGENT_MAX_RUN_MS=600000
# AGENT_MAX_ITERATIONS=80
# AGENT_MAX_TOOL_CALLS_TOTAL=400

# Credits / Billing (server-side)
# Minimum credits required to start a chat run (enforced in /api/chat/stream).
TUNA_MIN_CREDITS_TO_START=1
# Optional cap: maximum credits that can be charged for a single agent run.
TUNA_MAX_CREDITS_PER_RUN=
# Optional E2B billing rates (leave blank to disable E2B charging).
TUNA_E2B_SESSION_CREDITS_PER_MINUTE=
TUNA_E2B_TRAINING_CREDITS_PER_MINUTE=

# Stripe (optional; required for checkout/portal/webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-01
NEXT_PUBLIC_STRIPE_SUBSCRIPTION_PRICE_ID=
NEXT_PUBLIC_STRIPE_TOPUP_PRICE_ID=

# Agent Context Window (server-side)
# These settings control how much chat history/tool output is included in each LLM call.
# Note: Azure deployment context length can differ from OpenAI docs; tune for your deployment.
TUNA_AGENT_MAX_CONTEXT_TOKENS=400000
# If your Azure deployment enforces a separate max input cap, set it here.
# Example (gpt-5.2): total=400000, max_input=272000, max_output=128000
TUNA_AGENT_MAX_INPUT_TOKENS=272000
TUNA_AGENT_MAX_OUTPUT_TOKENS=4096
TUNA_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=2048
TUNA_AGENT_SUMMARY_MAX_OUTPUT_TOKENS=900
TUNA_AGENT_SUMMARY_TRIGGER_FRACTION=0.8
TUNA_AGENT_LOG_CONTEXT=false
# Optional hard caps to prevent extremely large tool/assistant messages from blowing up context.
TUNA_AGENT_TOOL_MESSAGE_MAX_CHARS=24000
TUNA_AGENT_ASSISTANT_MESSAGE_MAX_CHARS=32000

RESEND_API_KEY=resend-api-key
RESEND_FROM_EMAIL=contact@tuna.so
RESEND_FROM_NAME=TUNA

# Email notifications
# Cooldown to prevent queued-task start emails from spamming.
TUNA_QUEUED_TASK_START_EMAIL_COOLDOWN_MINUTES=60

# E2B and OpenAI (required for runner; can use same as main app root .env)
E2B_API_KEY=your-e2b-api-key
OPENAI_API_KEY=your-openai-api-key

# E2B Runner (server-only)
E2B_RUNNER_URL=https://runner.example.com
E2B_RUNNER_TOKEN=your-runner-shared-token
E2B_RUNNER_TIMEOUT_MS=30000
RUNNER_SIGNED_URL_TTL_SECONDS=900
RUNNER_MODEL_COPY_MAX_BYTES=50000000
# Additional safety limits (server-side)
RUNNER_MAX_FILE_BYTES=20000000
RUNNER_PERSIST_TREE_MAX_FILES=1000
RUNNER_PERSIST_TREE_MAX_BYTES=100000000
RUNNER_REPO_SNAPSHOT_MAX_FILES=2000
RUNNER_REPO_SNAPSHOT_MAX_BYTES=100000000
# Optional custom template for code-interpreter sandboxes (training + /sessions)
# RUNNER_E2B_TEMPLATE=your-template-id
# Sandbox dependency bootstrap profile (core | extended | off)
RUNNER_E2B_PREINSTALL_COLAB_DEPS=true
RUNNER_E2B_PREINSTALL_PROFILE=core
RUNNER_E2B_PREINSTALL_STRICT=false
RUNNER_E2B_PREINSTALL_TIMEOUT_SECONDS=1200
RUNNER_E2B_PREINSTALL_EXTRA_PACKAGES=
# Sandbox tool output clipping (server-only)
RUNNER_SANDBOX_OUTPUT_MAX_CHARS=8000
# Desktop runner options (server-only)
RUNNER_DESKTOP_TEMPLATE=desktop
RUNNER_DESKTOP_ALLOW_INTERNET=true
RUNNER_DESKTOP_TTL_SECONDS=7200
RUNNER_MAX_DESKTOP_SESSIONS=8
# Optional server-wide integration token fallbacks
HUGGINGFACE_TOKEN=
HF_TOKEN=
GITHUB_TOKEN=
# Optional aliases accepted by the agent:
# GITHUB_PAT=
# GITHUB_PERSONAL_ACCESS_TOKEN=
KAGGLE_TOKEN=
FIRECRAWL_API_KEY=

# Optional: override OpenAI model for autofix
# OPENAI_MODEL=gpt-5.2